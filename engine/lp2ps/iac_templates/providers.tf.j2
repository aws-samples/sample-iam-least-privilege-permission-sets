# Identity Center Permission Set 정의용 provider. account assignment 은 별도 파일(사람 검토 후 적용).
terraform {
  required_version = ">= 1.5"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = ">= 5.0"
    }
  }
}

provider "aws" {
  region = "{{ region }}"
}

# Identity Center instance ARN 은 배포 시 주입(tooling 계정). 빈 값이면 apply 전에 채운다.
variable "identity_center_instance_arn" {
  type        = string
  description = "IAM Identity Center instance ARN (tooling account)"
  default     = "{{ identity_center_instance_arn }}"
}
