# Generated by LP2PS — do not edit by hand. Deterministic output.
# persona → Identity Center Permission Set 정의(inline policy = 최소권한 합성 결과).
# account assignment(멤버계정 권한 부여)은 여기 없음 — account_assignments.tf 참조(사람 수동).
{% for ps in permission_sets %}
resource "aws_ssoadmin_permission_set" "{{ ps.resource_name }}" {
  name             = "{{ ps.name }}"
  description      = "{{ ps.description }}"
  instance_arn     = var.identity_center_instance_arn
  session_duration = "{{ ps.session_duration }}"
  tags = {
    ManagedBy          = "lp2ps"
    Persona            = "{{ ps.persona }}"
    SynthesisSource    = "{{ ps.synthesis_source }}"
  }
}

resource "aws_ssoadmin_permission_set_inline_policy" "{{ ps.resource_name }}" {
  instance_arn       = var.identity_center_instance_arn
  permission_set_arn = aws_ssoadmin_permission_set.{{ ps.resource_name }}.arn
  inline_policy      = jsonencode({{ ps.inline_policy }})
}
{% endfor %}
