# LP2PS frontend environment variables (example) — copy this file to `.env` and fill in the values.
# (.env is gitignored — do not commit it.)

# Mock-data mode. true = mock, false = real API (after deployment).
VITE_USE_MOCKS=true

# Real API endpoint (injected automatically by build-web.sh at deploy time, or set manually here).
# VITE_API_BASE=https://<api-id>.execute-api.<region>.amazonaws.com/prod

# Injected automatically by infra/scripts/deploy-all.sh. Required for production builds.
# Leave empty only for mock-mode local dev.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
